{
  "identifier": "default",
  "description": "wxwright main window default capabilities",
  "windows": ["main"],
  "permissions": [
      "core:default",
      "dialog:default",
      "opener:default",
      { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }] },
      { "identifier": "opener:allow-reveal-item-in-dir", "allow": [{ "path": "**" }] }
    ]
}
